# Techo — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env` (it contains secrets).
# Loaded by the Node server via process.env (see server). The frontend NEVER
# reads these directly — it requests short-lived tokens from the backend.

# ---- Server ---------------------------------------------------------------
PORT=4321
# Session-cookie signing secret. CHANGE THIS in production (use a long random string).
VY_COOKIE_SECRET=change-me-to-a-long-random-string
# Public base URL of the running server (used for webhook callbacks & UI links).
PUBLIC_BASE_URL=http://localhost:4321

# ---- Agora Conversational AI (Voice AI) ------------------------------------
# Required to move off mock mode and enable live voice-AI agents.
# Create these in the Agora Console (console.agora.io):
#   - App ID + App Certificate
#   - Customer ID + Customer Secret (RESTful API / Conversational AI)
#   - A voice-AI agent (App Builder / AI Studio) → your AGORA_AGENT_ID / AGORA_PIPELINE_ID

# Agora App (used for RTC transport + Conversational AI tokens)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# RESTful customer credentials — these are used server-side ONLY to mint
# short-lived tokens; they are never sent to the browser.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# The voice-AI agent to use for conversations.
# Either AGORA_AGENT_ID (agent-based join) or AGORA_PIPELINE_ID (pipeline-based join).
AGORA_AGENT_ID=
# AGORA_PIPELINE_ID=

# Optional region override (GLOBAL | ASIA | INDIA | ...). Defaults to GLOBAL.
# AGORA_REGION=GLOBAL

# Environment: dev | staging | prod  (controls the dashboard status label)
AGORA_ENV=dev

# ---- Webhooks ---------------------------------------------------------------
# When set, /api/agora/webhooks verifies Agora signatures (HMAC SHA-256).
# Agora must be configured to POST events to: {PUBLIC_BASE_URL}/api/agora/webhooks
WEBHOOK_SECRET=

# Optional: secret used if you cache tokens server-side (not required).
AGORA_CACHE_TOKEN_SECRET=

# ---- Optional external providers (kept for the existing pipeline) ----------
# When set, these upgrade the mock/browser fallbacks to real providers.
# DEEPGRAM_API_KEY=            # ASR (speech-to-text)
# ELEVENLABS_API_KEY=          # TTS (text-to-speech)
# OPENAI_API_KEY=              # LLM replies
# TELNYX_API_KEY=              # outbound telephony
# ZENDESK_SUBDOMAIN=           # human-agent helpdesk tickets

# ---- Google Calendar ("Give Scheduling a Voice") ---------------------------
# Google Cloud → enable Calendar API → OAuth 2.0 client (Web) with redirect
# URI {PUBLIC_BASE_URL}/api/calendar/callback. Until set, the UI shows
# "Google Calendar not configured" + these steps; voice scheduling falls
# back to local reminders.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Email via Resend ("Give Email a Voice") --------------------------------
# resend.com → API key. RESEND_FROM needs a verified domain for production;
# the default onboarding@resend.dev works for tests.
# RESEND_API_KEY=
# RESEND_FROM=Techo <onboarding@resend.dev>

# ---- Stripe read-only demo ("Give Payments a Voice") ------------------------
# Test-mode secret key only (sk_test_…). Without it, payments answers use
# clearly-labeled demo figures from the local ledger. Read-only: the app
# only lists charges, never creates payments.
# STRIPE_SECRET_KEY=

# ---- Talking-head avatar ("Give the AI a Face", HeyGen) ----------------------
# Optional visual layer on top of Agora voice. When unset the studio shows
# "Avatar not configured" and voice works completely unchanged. Secrets stay
# server-side; only provider/configured booleans are ever sent to the client.
# AVATAR_PROVIDER=heygen            # provider selector (heygen | none)
# HEYGEN_API_KEY=                   # create at heygen.com → API settings

# ---- Notes ----------------------------------------------------------------
# Mock mode is fully runnable without any of the above. The dashboard reports
# honest "Mock mode / Not configured" states until credentials are present.
